DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
BASE_CURRENCY=SAR
SUPPORTED_CURRENCIES=SAR,USD,AED
SUPPORTED_LANGUAGES=ar,en
TAX_RATE_BPS=1500
FREE_SHIPPING_THRESHOLD_CENTS=30000
DEFAULT_SHIPPING_CENTS=1500
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
SHIPPING_PROVIDER=sandbox
PUBLIC_STORE_URL=http://localhost:3000
INVENTORY_EXPIRY_WARNING_DAYS=30
INVENTORY_SLOW_MOVING_DAYS=60
# Optional server-side AI analyst. The dashboard works locally when this is empty.
OPENAI_API_KEY=
OPENAI_INVENTORY_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=20
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=NOVA <no-reply@example.com>
# Optional S3-compatible media storage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=me-south-1
# AWS_S3_ENDPOINT_URL=
# Optional monitoring
# SENTRY_DSN=
