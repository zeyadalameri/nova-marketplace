POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=generate-a-long-random-password
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_ALLOWED_HOSTS=shop.example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
PUBLIC_STORE_URL=https://shop.example.com
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
SHIPPING_PROVIDER=sandbox

# Object storage / CDN (leave bucket empty to use the local media volume)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=0

# SMTP (the default prints email to backend logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=NOVA <no-reply@example.com>

# Commerce rules and API limits
BASE_CURRENCY=SAR
TAX_RATE_BPS=1500
DEFAULT_SHIPPING_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=30000
API_ANON_RATE=120/min
API_USER_RATE=600/min
INVENTORY_EXPIRY_WARNING_DAYS=30
INVENTORY_SLOW_MOVING_DAYS=60

# Optional AI inventory analyst. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_INVENTORY_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=20

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
